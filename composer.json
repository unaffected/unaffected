{
    "name": "diagonal/platform",
    "description": "Diagonal platform proof of concept: gateway, kernel and hooks over NATS.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.6",
        "basis-company/nats": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "true-async/ide-helper": "*"
    },
    "autoload": {
        "psr-4": {
            "Diagonal\\": "source/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Diagonal\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.6.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
